manifest {
    name = 'bhklab/Mol-JEPA-embeddings'
    mainScript = 'main.nf'
    nextflowVersion = '>=25.10.0'
}

params {
    help = false
    downloads = "${projectDir}/config/downloads.yaml"
    embeddings = "${projectDir}/config/embeddings.yaml"
    raw_data = null
    molset = null
    container_image = null
    outdir = "${projectDir}/data/results/nextflow"
}

profiles {
    standard {
        workDir = "${projectDir}/data/work"
        process.executor = 'local'
    }
    docker {
        workDir = "${projectDir}/data/work"
        process.executor = 'local'
        docker.enabled = true
        process.container = params.container_image
    }
    dnanexus {
        // DNAnexus supplies the executor and cloud work directory.
        docker.enabled = true
        process.container = params.container_image
        process.disk = '20 GB'
        params.outdir = 'results'
    }
}
env.PYTHONDONTWRITEBYTECODE = '1'
executor.queueSize = 2

trace {
    enabled = true
    file = "${params.outdir}/trace-${new Date().format('yyyyMMdd-HHmmss')}.tsv"
}
report {
    enabled = true
    file = "${params.outdir}/report-${new Date().format('yyyyMMdd-HHmmss')}.html"
}
timeline {
    enabled = true
    file = "${params.outdir}/timeline-${new Date().format('yyyyMMdd-HHmmss')}.html"
}
